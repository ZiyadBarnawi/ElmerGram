{
  "name": "angular-instagram-profile",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve ",
    "start:local": "ng serve --configuration localDevelopment",
    "start:spring": "ng serve --configuration springDevelopment",
    "start:node": "ng serve --configuration nodeDevelopment",
    "build": "ng build ",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
